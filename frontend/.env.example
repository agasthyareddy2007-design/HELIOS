# HELIOS frontend configuration
#
# SERVER-SIDE ONLY (never shipped to the browser). The Next.js route handler at
# /api/helios/* injects the API key when proxying to the HELIOS V1/V2 API, so the
# secret never appears in client JavaScript.

# Tailscale Funnel / Backend API Base URL
HELIOS_API_BASE=https://cachyos-agasthya.tail1cd259.ts.net

# API Key
HELIOS_API_KEY=replace_with_your_key

# Request timeout for upstream API calls (ms)
HELIOS_API_TIMEOUT_MS=15000

# Live endpoints timeout
HELIOS_LIVE_TIMEOUT_MS=60000
