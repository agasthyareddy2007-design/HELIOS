# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/helios
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# API Keys (DO NOT commit real keys)
ECMWF_API_KEY=your_ecmwf_key_here
ECMWF_API_URL=https://api.ecmwf.int/v1
NASA_POWER_API_KEY=your_nasa_power_key_here
NOAA_API_KEY=your_noaa_key_here
UKMO_API_KEY=your_ukmo_key_here

# Weather Data APIs
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_URL=https://api.weatherapi.com/v1

# Storage Configuration
DATA_ROOT=/home/agasthya/HELIOS/data
MODEL_ROOT=/home/agasthya/HELIOS/models
MAX_STORAGE_GB=220

# Training Configuration
TRAINING_DEVICE=cuda
TRAINING_WORKERS=4
CHECKPOINT_FREQUENCY=epoch

# Inference Configuration
INFERENCE_DEVICE=cuda
INFERENCE_BATCH_SIZE=32

# Frontend Configuration
FRONTEND_URL=https://helios.yourdomain.com
API_BASE_URL=http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=/home/agasthya/HELIOS/logs/helios.log

# Security (generate strong secrets in production)
SECRET_KEY=change_this_to_a_secure_random_string
JWT_SECRET=change_this_to_another_secure_random_string
API_TOKEN=your_secure_api_token_here

# Model Versioning
CHAMPION_MODEL_VERSION=0.1.0
