# HELIOS V2 Configuration
# -------------------------

# Cloudflare Tunnel (For API Ingress via Zero Trust)
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# API Key Authentication (Backend)
# Pepper used for PBKDF2 hashing - CHANGE THIS IN PRODUCTION
HELIOS_API_KEY_PEPPER=helios_default_pepper_2026
# Optional bootstrap admin secret for first-time setup (e.g. "hl_admin_00000000...")
HELIOS_ADMIN_BOOTSTRAP_SECRET=

# API Key Setup (Frontend)
# The API key the frontend uses for proxying downstream X-API-Key requests
# The internal Docker URL to reach the backend from the frontend container
HELIOS_API_BASE=http://127.0.0.1:8011

# Legacy/Data Dependencies
ECMWF_API_KEY=your_ecmwf_key_here
ECMWF_API_URL=https://api.ecmwf.int/v1
NASA_POWER_API_KEY=your_nasa_power_key_here
NOAA_API_KEY=your_noaa_key_here
WEATHER_API_KEY=your_weather_api_key_here

# Storage
DATA_ROOT=/app/data
MODEL_ROOT=/app/ml/artifacts

# Logging
LOG_LEVEL=INFO

# Dynamic Backend URL Discovery (Vercel Frontend Serverless)
# Enables Vercel serverless functions to dynamically locate the ephemeral Mini-PC URL
# HELIOS_DISCOVERY_LOCATOR=dns:helios.duckdns.org
# HELIOS_DISCOVERY_LOCATOR=https://api.github.com/gists/YOUR_GIST_ID
# HELIOS_DISCOVERY_TOKEN=optional_github_pat

# Discovery Updaters (Mini-PC Edge Node)
# HELIOS_DUCKDNS_DOMAIN=yoursubdomain
# HELIOS_DUCKDNS_TOKEN=your_duckdns_token
# HELIOS_GIST_ID=your_gist_id
# HELIOS_GIST_TOKEN=your_github_pat
